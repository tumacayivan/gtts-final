{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gtts-react",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "react-app",
      "port": 4322
    },
    {
      "name": "verify-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "4500", "--strictPort"],
      "cwd": "react-app",
      "port": 4500
    },
    {
      "name": "standalone",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4399"],
      "cwd": "react-app/standalone-build",
      "port": 4399
    }
  ]
}
