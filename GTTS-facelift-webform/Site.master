<%@ Master Language="C#" AutoEventWireup="true" %>
<%@ Register Src="~/Controls/Header.ascx" TagPrefix="gtts" TagName="Header" %>
<%@ Register Src="~/Controls/Footer.ascx" TagPrefix="gtts" TagName="Footer" %>

<!doctype html>
<html lang="en">
  <head runat="server">
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    <style>
      .site-header .nav-actions {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .site-header .nav-language {
        min-width: 156px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border: 1px solid rgba(15, 79, 140, 0.18);
        border-radius: 12px;
        background: #fff;
        color: #173c62;
      }

      .site-header .nav-language .form-select {
        min-width: 112px;
        border: 0;
        box-shadow: none;
        padding-top: 0;
        padding-bottom: 0;
        background-color: transparent;
        font-weight: 700;
      }

      @media (max-width: 1199.98px) {
        .site-header .nav-actions {
          align-items: flex-start;
          flex-direction: column;
          margin-top: 18px;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#mainContent" data-i18n="skip">Skip to main content</a>
    <div class="page-shell">
      <gtts:Header runat="server" ID="SiteHeader" />
      <asp:ContentPlaceHolder ID="MainContent" runat="server" />
      <gtts:Footer runat="server" ID="SiteFooter" />
    </div>
    <script src="assets/webforms-chrome.js"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
  </body>
</html>
