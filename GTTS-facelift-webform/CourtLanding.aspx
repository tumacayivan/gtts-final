  overflow-x: clip;
}

.utility-bar {
  min-height: 40px;
  max-height: 40px;
  display: flex;
  align-items: center;
  background: var(--brand-navy);
  color: #fff;
}

.utility-bar .container-xxl {
  padding-left: clamp(18px, 3vw, 42px);
  padding-right: clamp(18px, 3vw, 32px);
}

.share-button {
  min-width: 180px;
  height: 28px;
  max-height: 30px;
  border: 1px solid rgba(255, 255, 255, 0.82);
  border-radius: 8px;
  background: transparent;
  color: #fff;
  font-size: 13px;
  letter-spacing: 0.9px;
  text-transform: uppercase;
}

.utility-phone {
  color: #fff;
  font-size: 15px;
  letter-spacing: 0.2px;
}

.main-nav {
  min-height: 108px;
  padding: 0;
  border-bottom: 1px solid #eef2f6;
}

.main-nav .container-xxl {
  padding-left: clamp(18px, 2.6vw, 36px);
  padding-right: clamp(18px, 2vw, 20px);
}

.navbar-brand img {
  width: clamp(220px, 20vw, 282px);
  display: block;
}

.main-nav .nav-link {
  color: #111;
  font-size: 15px;
  font-weight: 500;
  padding: 10px 13px;
  white-space: nowrap;
}

.main-nav .nav-link:hover,
.main-nav .nav-link:focus {
