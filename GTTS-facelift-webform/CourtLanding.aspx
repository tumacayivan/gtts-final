}

.faq-section {
  padding: 48px 0 64px;
  background: #fff;
}

.section-heading {
  max-width: 920px;
  margin: 0 auto 34px;
  text-align: center;
}

.section-heading span {
  display: block;
  margin-bottom: 12px;
  color: #111;
  font-size: 18px;
