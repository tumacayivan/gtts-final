    <style>
:root {
  --brand-navy: #123a59;
  --brand-blue: #004985;
  --brand-blue-2: #017bb6;
  --brand-red: #ff4e4e;
  --brand-light: #eff9ff;
  --footer-blue: #d9ebf4;
  --ink: #101820;
  --muted: #606975;
  --line: #d9e4ec;
  --success: #2d9a47;
}

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

body {
  margin: 0;
  background: #fff;
  color: var(--ink);
  font-family: "Open Sans", Arial, Helvetica, sans-serif;
  letter-spacing: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
