}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-left: 16px;
}

.language-wrap {
  width: 134px;
  min-height: 40px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 6px 7px 10px;
  border: 1px solid #ebebeb;
  border-radius: 8px;
  background: #fff;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.04);
}

.language-wrap i {
  color: #40464f;
  font-size: 16px;
}

.language-wrap .form-select {
  height: 26px;
  border: 0;
  background-color: transparent;
  box-shadow: none;
  color: #3b3b3b;
  font-size: 14px;
  font-weight: 500;
  padding: 0 24px 0 0;
}

.login-link {
  min-width: 98px;
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 6px;
  background: var(--brand-navy);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
