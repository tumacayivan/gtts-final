  width: 158px;
  filter: drop-shadow(0 9px 18px rgba(0, 0, 0, 0.18));
}

.selected-path {
  margin-top: 48px;
  padding-left: 8px;
  display: grid;
  gap: 13px;
  font-size: 18px;
}

.selected-path strong {
  font-weight: 400;
}

.selected-path span {
