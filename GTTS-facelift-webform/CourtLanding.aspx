  transform: translateY(0);
}

@media (max-width: 1199.98px) {
  .main-nav {
    min-height: auto;
    padding: 14px 0;
  }

  .nav-actions {
    align-items: flex-start;
    flex-direction: column;
    margin: 18px 0 0;
  }

  .hero-content h1 {
    font-size: clamp(26px, 2.6vw, 30px);
    letter-spacing: 0.4px;
  }

