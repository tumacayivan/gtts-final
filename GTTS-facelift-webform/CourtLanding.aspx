  background: var(--footer-blue);
}

.footer-main .container-xxl {
  padding-left: clamp(22px, 5vw, 72px);
  padding-right: clamp(22px, 5vw, 72px);
}

.footer-brand img {
  width: 240px;
  margin-bottom: 28px;
}

.footer-brand p {
