  align-items: center;
  gap: 12px;
}

.footer-contact i {
  width: 24px;
  color: #287fc0;
  font-size: 19px;
}

.site-footer h3 {
  margin: 20px 0 18px;
  color: #064779;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 1px;
}

.footer-links {
  display: grid;
  gap: 14px;
  font-size: 16px;
}

.social-links {
