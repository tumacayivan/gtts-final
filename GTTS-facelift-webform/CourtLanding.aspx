  margin: 0 0 28px;
  color: #004a80;
  font-size: 16px;
  line-height: 1.6;
}

.footer-contact,
.footer-links,
.social-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-contact {
  display: grid;
  gap: 14px;
  font-size: 16px;
}

.footer-contact li,
.social-links li a {
