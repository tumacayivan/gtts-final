}

.red-button {
  min-width: clamp(164px, 16.25vw, 333px);
  min-height: clamp(32px, 3.15vw, 65px);
  background: var(--brand-red);
  font-size: clamp(15px, 1.4vw, 29px);
  letter-spacing: clamp(0.4px, 0.06vw, 1.2px);
}

.primary-button {
